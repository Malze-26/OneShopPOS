{
  "name": "oneshop-tenant-factory",
  "version": "1.0.0",
  "description": "OneShop Super Admin — tenant provisioning and management API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node src/seed.ts",
    "hash-password": "ts-node src/hash-password.ts",
    "provision": "ts-node src/scripts/provisionExistingTenants.ts",
    "seed:open-door": "ts-node src/scripts/seedOpenDoorFromOneshop.ts",
    "update:open-door-settings": "ts-node src/scripts/updateOpenDoorSettings.ts",
    "seed:tenant-users": "ts-node src/scripts/seedAllTenantUsers.ts",
    "sync:open-door": "ts-node src/scripts/syncOpenDoorBusinessInfo.ts",
    "migrate:super-user": "ts-node src/scripts/migrateToSuperUser.ts",
    "backfill:plan": "ts-node src/scripts/backfillSubscriptionPlan.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
