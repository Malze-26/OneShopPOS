{
  "name": "oneshoppos",
  "version": "1.0.0",
  "description": "OneShop POS System",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
