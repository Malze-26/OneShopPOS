# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# A single MongoDB server hosts every tenant; each tenant is a database on it,
# selected per request from the OneShop-Tenant-ID header.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Registry database written by oneshop-tenant-factory.
TENANT_FACTORY_DB=oneshop-tenant-factory

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── File uploads (S3) ────────────────────────────────────────────────────────
# Uploads go browser -> S3 directly via a presigned POST; files never pass
# through this API. That keeps requests under Lambda's 6MB payload ceiling and
# removes the local-disk dependency that blocked serverless deployment.
S3_BUCKET=oneshop-uploads-293528979228
AWS_REGION=ap-south-1

# Public base URL for stored objects. Set this to your CloudFront domain so
# assets are served from the CDN; if unset, direct S3 URLs are used.
ASSET_BASE_URL=https://cdn.allinoneshop.store

# Credentials: leave unset in AWS — the Lambda/ECS execution role supplies them.
# Only needed for local development against a real bucket.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
